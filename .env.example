APP_ENV=development
MCP_HOST=127.0.0.1
MCP_PORT=8000
MAX_UPLOAD_BYTES=52428800
# Point this at an official INEGI-derived GeoJSON/CSV catalog in production.
GEOGRAPHY_CATALOG_PATH=data/geography.catalog.geojson
GEOMETRY_ROOT_PATH=data/geography/hidalgo
# Keep false until the catalog has been reviewed and validated.
ALLOW_FUZZY_AUTO_MATCH=false
# Public map server (optional; local URLs are used when this is blank).
PUBLIC_BASE_URL=http://127.0.0.1:8770
HOSTED_MAPS_DIR=work/hosted-maps
SHEET_REFRESH_SECONDS=60
# Production: connect a Vercel Blob store and add this token in Vercel Project Settings.
BLOB_READ_WRITE_TOKEN=
